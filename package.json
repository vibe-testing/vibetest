{
  "name": "vibetest",
  "version": "0.1.0",
  "description": "AI-powered E2E test generation CLI",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "vibetest": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun run build:xpath && bun build src/index.ts --compile --outfile=dist/vibetest --external playwright --external playwright-core --external sharp",
    "build:xpath": "bun run scripts/bundle-browser-xpath.mjs",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "baml:generate": "bunx @boundaryml/baml generate"
  },
  "dependencies": {
    "@boundaryml/baml": "^0.218.0",
    "@inquirer/prompts": "^8.2.0",
    "chalk": "^5.4.1",
    "commander": "^14.0.2",
    "graphology": "^0.26.0",
    "graphology-types": "^0.24.8",
    "ipaddr.js": "^2.3.0",
    "playwright": "^1.50.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "esbuild": "^0.27.2",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
