{
  "name": "vibetest",
  "version": "0.1.0",
  "description": "AI-powered E2E test generation CLI",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "vibetest": "src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --compile --outfile=dist/vibetest",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "baml:generate": "bunx @boundaryml/baml generate"
  },
  "dependencies": {
    "@boundaryml/baml": "^0.218.0",
    "playwright": "^1.50.0",
    "@inquirer/prompts": "^8.2.0",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
