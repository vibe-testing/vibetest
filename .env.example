# vibetest configuration
# Copy this file to .env and fill in your values

# LLM Provider API Keys (configure the ones you'll use)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default LLM provider: anthropic | openai
VIBETEST_LLM_PROVIDER=anthropic

# Default model (optional, provider-specific)
# VIBETEST_MODEL=claude-sonnet-4-20250514
